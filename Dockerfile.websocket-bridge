FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements-websocket-bridge.txt .
RUN pip install --no-cache-dir -r requirements-websocket-bridge.txt

# Copy WebSocket bridge script
COPY websocket-bridge-complete.py websocket-bridge.py

# Make the script executable
RUN chmod +x websocket-bridge.py

# Create non-root user for security
RUN useradd --create-home --shell /bin/bash bridge && \
    chown -R bridge:bridge /app
USER bridge

# Set environment variables
ENV WS_HOST=0.0.0.0
ENV WS_PORT=8081
ENV TARGET_HOST=localhost
ENV TARGET_PORT=26656
ENV PYTHONUNBUFFERED=1

# Expose WebSocket port
EXPOSE 8081

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python3 -c "import socket; s=socket.socket(); s.connect(('localhost', 8081)); s.close()" || exit 1

# Run the WebSocket bridge
CMD ["python3", "websocket-bridge.py"]
