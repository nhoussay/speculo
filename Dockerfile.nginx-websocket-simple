FROM nginx:alpine

# Install curl for health checks
RUN apk add --no-cache curl

# Copy our WebSocket-enabled nginx configuration
COPY nginx-websocket.conf /etc/nginx/nginx.conf

# Create simple index page for fallback
RUN echo '<!DOCTYPE html>' > /usr/share/nginx/html/index.html && \
    echo '<html>' >> /usr/share/nginx/html/index.html && \
    echo '<head><title>Speculod WebSocket P2P Bridge</title></head>' >> /usr/share/nginx/html/index.html && \
    echo '<body>' >> /usr/share/nginx/html/index.html && \
    echo '<h1>Speculod WebSocket P2P Bridge</h1>' >> /usr/share/nginx/html/index.html && \
    echo '<p>WebSocket P2P endpoint: <code>wss://domain/</code></p>' >> /usr/share/nginx/html/index.html && \
    echo '<ul>' >> /usr/share/nginx/html/index.html && \
    echo '<li><a href="/rpc/status">RPC Status</a></li>' >> /usr/share/nginx/html/index.html && \
    echo '<li><a href="/api/cosmos/base/tendermint/v1beta1/node_info">API Node Info</a></li>' >> /usr/share/nginx/html/index.html && \
    echo '</ul>' >> /usr/share/nginx/html/index.html && \
    echo '</body>' >> /usr/share/nginx/html/index.html && \
    echo '</html>' >> /usr/share/nginx/html/index.html

# Expose port 80
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
