# Simplified Nginx Proxy using existing speculod base image
FROM speculod-base:latest AS speculod

# Final stage with nginx
FROM nginx:alpine

# Install supervisor and dependencies
RUN apk add --no-cache supervisor bash curl jq

# Copy the speculodd binary from base image
COPY --from=speculod /usr/local/bin/speculodd /usr/local/bin/speculodd

# Copy nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf

# Copy scripts
COPY scripts/ /app/scripts/
COPY config/ /app/config/

# Create supervisor configuration
RUN mkdir -p /etc/supervisor/conf.d /var/log/supervisor

# Create supervisor config for nginx + speculodd
COPY supervisord-nginx.conf /etc/supervisor/conf.d/supervisord.conf

# Create speculod user and directories
RUN adduser -D -s /bin/bash speculod && \
    mkdir -p /home/speculod/.speculod && \
    chown -R speculod:speculod /home/speculod

# Set executable permissions
RUN chmod +x /app/scripts/*.sh

# Expose the nginx proxy port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

# Override nginx entrypoint and start supervisor
ENTRYPOINT []
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
