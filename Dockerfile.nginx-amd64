# Multi-stage build for speculod with nginx reverse proxy - AMD64
FROM speculod-base:amd64 AS speculod-stage

# Build nginx proxy stage
FROM nginx:alpine

# Install bash, curl, and python3
RUN apk add --no-cache bash curl python3

# Copy speculodd binary from speculod-base
COPY --from=speculod-stage /usr/local/bin/speculodd /usr/local/bin/

# Copy nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf

# Copy Python startup script
COPY start-combined.py /start-combined.py
RUN chmod +x /start-combined.py

# Expose port 8080 for nginx proxy
EXPOSE 8080

# Use Python to run the startup script
CMD ["python3", "/start-combined.py"]
