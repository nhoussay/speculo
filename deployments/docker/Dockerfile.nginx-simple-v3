# Multi-stage build for speculod with nginx reverse proxy
FROM speculod-base:latest AS speculod-stage

# Build nginx proxy stage
FROM nginx:alpine

# Install bash and curl
RUN apk add --no-cache bash curl

# Copy speculodd binary from speculod-base
COPY --from=speculod-stage /usr/local/bin/speculodd /usr/local/bin/

# Copy nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf

# Copy startup script
COPY start-combined.sh /start-combined.sh
RUN chmod +x /start-combined.sh

# Expose port 8080 for nginx proxy
EXPOSE 8080

# Use the combined startup script
ENTRYPOINT ["/start-combined.sh"]
