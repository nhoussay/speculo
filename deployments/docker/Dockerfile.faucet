# Token Faucet Service - Lightweight Python service for token distribution
FROM python:3.12-slim

# Install curl for health checks
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Create faucet user
RUN adduser --disabled-password --gecos '' faucet

WORKDIR /app

# Copy faucet script and requirements
COPY scripts/faucet-server-flask.py ./
COPY requirements.txt ./

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy startup script
COPY scripts/faucet-service.sh /usr/local/bin/faucet-service.sh
RUN chmod +x /usr/local/bin/faucet-service.sh

# Set ownership
RUN chown -R faucet:faucet /app

USER faucet

# Environment variables
ENV SERVICE_TYPE=faucet
ENV FAUCET_PORT=8080
ENV BLOCKCHAIN_RPC_URL=http://blockchain-service:8080

# Expose port 8080 (Cloud Run requirement)
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=5 \
    CMD curl -f http://localhost:8080/health || exit 1

# Start faucet service directly
CMD ["python", "faucet-server-flask.py"]
