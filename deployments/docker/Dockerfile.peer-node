# Multi-stage build for Speculod Peer Node with Nginx proxy and WebSocket bridge
FROM golang:1.24-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git make gcc musl-dev linux-headers

# Set working directory
WORKDIR /build

# Copy go mod files and download dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the blockchain binary
RUN go install $(BUILD_FLAGS) -mod=readonly ./cmd/speculodd

# Runtime stage with minimal Alpine
FROM alpine:3.20

# Install runtime dependencies
RUN apk add --no-cache \
    ca-certificates \
    bash \
    curl \
    jq \
    nginx \
    supervisor \
    nodejs \
    npm

# Create user and group
RUN addgroup -g 1000 speculod && \
    adduser -D -s /bin/bash -u 1000 -G speculod speculod

# Copy the blockchain binary from builder
COPY --from=builder /go/bin/speculodd /usr/local/bin/speculodd

# Create application directory
RUN mkdir -p /app/scripts && \
    chown -R speculod:speculod /app

# Set working directory
WORKDIR /app

# Copy package.json for Node.js dependencies
COPY package.json ./
RUN npm install --production

# Copy startup scripts
COPY scripts/peer-node-start.sh ./scripts/
COPY scripts/websocket-bridge.js ./scripts/

# Copy configuration files
COPY nginx-single-port.conf /etc/nginx/conf.d/default.conf
COPY supervisord-peer-node.conf /etc/supervisor/conf.d/supervisord.conf

# Make scripts executable
RUN chmod +x ./scripts/peer-node-start.sh

# Create necessary directories and set permissions
RUN mkdir -p /home/speculod/.speculod/config /home/speculod/.speculod/data && \
    mkdir -p /run/nginx /var/log/nginx /var/log/supervisor && \
    chown -R speculod:speculod /home/speculod && \
    chown -R speculod:speculod /app && \
    chown nginx:nginx /run/nginx /var/log/nginx && \
    chmod 755 /home/speculod/.speculod

# Expose single port
EXPOSE 8080

# Use supervisor to manage multiple processes
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
