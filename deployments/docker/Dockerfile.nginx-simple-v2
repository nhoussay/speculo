# Multi-stage build for speculod with nginx reverse proxy
FROM speculod-base:latest AS speculod-stage

# Build nginx proxy stage
FROM nginx:alpine

# Install bash for our start script
RUN apk add --no-cache bash

# Copy speculodd binary and configuration from speculod-base
COPY --from=speculod-stage /usr/local/bin/speculodd /usr/local/bin/
COPY --from=speculod-stage /home/speculod/.speculod /root/.speculod

# Copy nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf

# Copy start script
COPY start-nginx-proxy.sh /start-nginx-proxy.sh
RUN chmod +x /start-nginx-proxy.sh

# Expose port 8080 for nginx proxy
EXPOSE 8080

# Set the start script as entrypoint
ENTRYPOINT ["/start-nginx-proxy.sh"]
